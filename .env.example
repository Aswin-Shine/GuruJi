# =============================================================================
#  GuruJi — configuration
#
#  Copy to .env and fill in.  .env is gitignored; never commit it.
#  Verify with:  git check-ignore .env      (must print ".env")
#
#  Generate each secret independently:
#    python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# ---- required ---------------------------------------------------------------
OPENAI_API_KEY=REPLACE-ME
POSTGRES_PASSWORD=REPLACE-WITH-A-LONG-RANDOM-STRING

# Signs every session token AND derives every parent-link PIN. The application
# falls back to a built-in default if this is unset, and there is currently no
# boot guard on it — see docs/SECURITY.md §3.1. Left at the default, anyone who
# has read this repository can forge a token for any student.
SECRET_KEY=REPLACE-WITH-A-LONG-RANDOM-STRING

# ---- WhatsApp (Meta) --------------------------------------------------------
# WHATSAPP_APP_SECRET verifies the X-Hub-Signature-256 header on every inbound
# webhook. Same missing-boot-guard caveat as SECRET_KEY: left at its default,
# anyone can sign a payload and send messages as any phone number.
WHATSAPP_APP_SECRET=REPLACE-ME
WHATSAPP_VERIFY_TOKEN=REPLACE-ME

# ---- environment ------------------------------------------------------------
# Any value other than "local" makes the app refuse to boot with DEV_OTP_BYPASS=1.
# The dev Compose override sets both of these for you; do not set DEV_OTP_BYPASS=1
# here.
APP_ENV=local
DEV_OTP_BYPASS=0

# ---- cost controls ----------------------------------------------------------
# $5/day suits roughly 20 pilot students. Estimated to break somewhere around
# 150-250 active students. Raise it deliberately rather than discovering the
# circuit-breaker fallback message in a transcript.
DAILY_SPEND_CAP_USD=5

# Slack-style incoming webhook, paged once per day when the breaker trips.
# Empty disables paging; the breaker still trips and still blocks.
ALERT_WEBHOOK_URL=

# ---- pilot access -----------------------------------------------------------
# Comma-separated E.164 numbers. EMPTY MEANS OPEN: anyone who learns the WhatsApp
# number gets a provisioned account and billed tutoring. Set this for any closed
# pilot. The app warns loudly at boot when this is empty outside local dev.
ALLOWED_PHONE_NUMBERS=

# ---- CORS -------------------------------------------------------------------
# Leave EMPTY. The web client is served same-origin through nginx, so the browser
# never makes a cross-origin request and the backend needs no allowance. Fill this
# in only if a frontend is ever hosted on a different origin — and never with "*",
# because a wildcard alongside credentials is a real vulnerability.
ALLOWED_WEB_ORIGINS=

# ---- retrieval tuning -------------------------------------------------------
# All optional; the defaults live in backend/app/config.py, which documents the
# measurement behind each one. See docs/EVALUATION.md before changing them, and
# note that config.py currently defaults RAG_THRESHOLD to 0.35 while every
# recorded evaluation run used 0.40 — reconcile these before quoting results.
#
#   RAG_THRESHOLD        grounded floor: at or above this, answer from the textbook
#   RAG_WEAK_THRESHOLD   hedge floor: between the two, answer briefly with a caveat
#   RAG_LEXICAL_RESCUE   1 keeps a lexical-only match scoring below the weak floor
#   RAG_TOP_K            chunks passed to the prompt
RAG_THRESHOLD=0.40
# RAG_WEAK_THRESHOLD=0.28
# RAG_LEXICAL_RESCUE=1
# RAG_TOP_K=5

# ---- Caddy / pilot gate -----------------------------------------------------
# Only needed with docker-compose.caddy.yml.
#
# GURUJI_PILOT_PASSWORD_HASH is a bcrypt hash, never the password itself:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
#
# WRAP THE HASH IN SINGLE QUOTES. A bcrypt hash begins "$2a$14$", and Compose
# treats $ as variable interpolation — unquoted, it expands $2a and $14 and hands
# Caddy a truncated string. The symptom is your own password being rejected with
# "crypto/bcrypt: hashedSecret too short to be a bcrypted password" while
# everything else looks healthy. Double quotes do NOT help; single quotes do.
#
# Verify after starting the stack — must print 60 characters beginning $2a$14$:
#   docker compose exec caddy printenv GURUJI_PILOT_PASSWORD_HASH
GURUJI_HOSTNAME=guruji.ddns.net
ACME_EMAIL=you@example.com
GURUJI_PILOT_USER=pilot
GURUJI_PILOT_PASSWORD_HASH='REPLACE-WITH-BCRYPT-HASH'